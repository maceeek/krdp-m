[Desktop Entry]
Type=Application
Name=Return Displays to This Computer
Comment=Turn the physical monitors back on while a remote desktop session uses a virtual monitor
Exec=@CMAKE_INSTALL_PREFIX@/bin/krdpserver --return-displays
Icon=video-display
X-KDE-Shortcuts=Meta+Ctrl+Alt+R
